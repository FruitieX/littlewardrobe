{
  "name": "littlewardrobe",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "prettier --write src scripts docs README.md AGENTS.md vite.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check src scripts docs README.md AGENTS.md vite.config.ts tsconfig.json package.json .prettierrc.json",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-pwa.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "node scripts/verify-production.mjs",
    "mockups": "node scripts/verify-production.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "test:container": "node scripts/verify-container.mjs",
    "test:oidc": "node scripts/verify-oidc.mjs",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
