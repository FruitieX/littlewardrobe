{
  "name": "littlewardrobe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src scripts docs README.md AGENTS.md vite.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check src scripts docs README.md AGENTS.md vite.config.ts tsconfig.json package.json .prettierrc.json",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-pwa.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "node scripts/verify-production.mjs",
    "mockups": "node scripts/verify-production.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "test:container": "node scripts/verify-container.mjs",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.59",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
