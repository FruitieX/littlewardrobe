# Copy to secret.sops.yaml, generate unique values, then SOPS-encrypt before committing.
apiVersion: v1
kind: Secret
metadata:
  name: littlewardrobe-server-env
type: Opaque
stringData:
  LITTLEWARDROBE_SETUP_TOKEN: REPLACE_WITH_RANDOM_SETUP_TOKEN
  LITTLEWARDROBE_SECRET_KEY: REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
